# ============================================================
# GymFlow AI — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ============================================================

# --- AI / LLM Providers ---
# OpenAI API key (used for embeddings: text-embedding-3-large)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API key (used for chat LLMs: nvidia/nemotron models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini / PaLM API key (used for audio transcription)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Messaging & Notifications ---
# Telegram Bot Token (for admin approval notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Admin Chat ID (the chat that receives approval requests)
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# --- WhatsApp / Chatwoot ---
# Chatwoot instance URL
CHATWOOT_BASE_URL=https://your-chatwoot-instance.example.com

# Chatwoot API Access Token (configure inside n8n HTTP Request nodes)
CHATWOOT_API_ACCESS_TOKEN=your_chatwoot_api_access_token_here

# Chatwoot Account ID
CHATWOOT_ACCOUNT_ID=your_chatwoot_account_id_here

# Chatwoot Inbox ID (WhatsApp inbox)
CHATWOOT_INBOX_ID=your_inbox_id_here

# --- Database: PostgreSQL / Supabase ---
# Full PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/gymflow_db

# Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Google Services ---
# Google Drive Folder ID (for Knowledge Base documents)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Google Sheets Spreadsheet ID (for tracking processed files)
GOOGLE_SHEETS_ID=your_google_sheets_spreadsheet_id_here

# --- n8n Configuration ---
# Your n8n instance base URL (used for webhook endpoints)
N8N_BASE_URL=https://your-n8n-instance.example.com

# n8n webhook path for WhatsApp integration
N8N_WHATSAPP_WEBHOOK_PATH=n8nn
